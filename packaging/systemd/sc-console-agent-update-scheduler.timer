[Unit]
Description=SC Console Agent - Auto Update Timer (every 1 minute)
Documentation=https://docs.cloud.strettch.com/agents/sc-agent

[Timer]
# Start 1 minute after boot
OnBootSec=1min

# Run 1 minute after the timer is activated
OnActiveSec=1min

# Run every 1 minute after the last run
OnUnitActiveSec=1min

# Add a small randomized delay to prevent all agents from checking at the same time
RandomizedDelaySec=10s

# Persist last trigger time across reboots
Persistent=true

# Timer accuracy
AccuracySec=10s

# Service to trigger
Unit=sc-console-agent-update-scheduler.service

[Install]
WantedBy=timers.target
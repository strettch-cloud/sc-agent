[Unit]
Description=SC Console Agent - Auto Update Timer (every 30 seconds - TESTING)
Documentation=https://docs.cloud.strettch.com/agents/sc-console-agent

[Timer]
# Start 30 seconds after boot (testing)
OnBootSec=30s

# Run 30 seconds after the timer is activated (testing)
OnActiveSec=30s

# Run every 30 seconds after the last run (testing)
OnUnitActiveSec=30s

# Disable randomized delay for testing
# RandomizedDelaySec=5min

# Persist last trigger time across reboots
Persistent=true

# Timer accuracy
AccuracySec=1s

# Service to trigger
Unit=sc-console-agent-update-scheduler.service

[Install]
WantedBy=timers.target
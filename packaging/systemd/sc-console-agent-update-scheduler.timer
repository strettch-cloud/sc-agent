[Unit]
Description=SC-Agent Auto-Update Timer
Documentation=https://docs.cloud.strettch.com/agents/sc-console-agent
Requires=sc-console-agent-update-scheduler.service

[Timer]
# Check for updates every 2 hours
OnBootSec=10min
OnUnitActiveSec=2h
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
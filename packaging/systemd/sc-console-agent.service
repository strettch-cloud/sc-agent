[Unit]
Description=Strettch Cloud Agent - The secure bridge between this vm instance and the cloud control plane.
Documentation=https://docs.cloud.strettch.com/agents/sc-console-agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStartPre=/usr/local/bin/sc-console-agent -validate-config
ExecStart=/usr/local/bin/sc-console-agent
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID

# Restart configuration
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=0
SuccessExitStatus=0 2
TimeoutStartSec=90
TimeoutStopSec=90

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Security hardening
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/etc/sc-console-agent /var/run/sc-console-agent /root/.ssh /home
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Environment
EnvironmentFile=-/etc/sc-console-agent/environment
Environment="SC_AGENT_CONFIG=/etc/sc-console-agent/config.yaml"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sc-console-agent

# User/Group
User=root
Group=root

# Kill configuration
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target 
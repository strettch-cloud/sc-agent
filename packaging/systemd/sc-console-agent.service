[Unit]
Description=SC Console Agent - Secure VM console access management
Documentation=https://docs.cloud.strettch.com/agents/sc-console-agent
After=network-online.target sshd.service
Wants=network-online.target
Requires=network.target

# Restart limiting
StartLimitIntervalSec=3600  # 1 hour window
StartLimitBurst=20         # 20 restarts allowed

[Service]
Type=simple
ExecStart=/usr/bin/sc-console-agent
ExecReload=/bin/kill -HUP $MAINPID

# Restart configuration
Restart=always
RestartSec=30
RestartPreventExitStatus=0

# Timeouts
TimeoutStartSec=90
TimeoutStopSec=90

# Kill configuration
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes
FinalKillSignal=SIGKILL

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=512M
MemorySwapMax=0  # Prevent swapping
CPUQuota=80%  

# Memory protection
OOMScoreAdjust=-500  # avoid OOM killer

# Security
User=root
Group=root
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=no  # Need access to home dirs for SSH keys
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DevicePolicy=closed
PrivateDevices=yes
SystemCallFilter=@system-service @network-io
SystemCallErrorNumber=EPERM

# Filesystem access (only what's needed)
ReadWritePaths=/etc/sc-console-agent /var/run/sc-console-agent
# For SSH key management - be specific about paths
ReadWritePaths=/root/.ssh /home/*/.ssh
# For reading SSH config
ReadOnlyPaths=/etc/ssh

# Environment
Environment="PATH=/usr/local/sbin:/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=-/etc/sc-console-agent/environment

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=SCConsoleAgent
SyslogLevel=info

# Process management
Delegate=no
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
[Unit]
Description=SC Agent Updater
Documentation=https://github.com/strettch/sc-console-agent
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sc-console-agent-updater.sh
User=root
Group=root
StandardOutput=journal
StandardError=journal
RemainAfterExit=no
Restart=no
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

# Timeout settings
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target